{
  "Rag": {
    "DefaultTopK": 5,
    "MaxTopK": 20,
    "PromptTokenBudget": 6000,
    "ApproxCharsPerToken": 4
  },
  "Ollama": {
    "TimeoutSeconds": 300
  },
  "RabbitMq": {
    "Processing": {
      "MaxAttempts": 5,
      "InitialDelaySeconds": 5,
      "MaxDelaySeconds": 300,
      "BackoffMultiplier": 2.0,
      "LeaseDurationSeconds": 120,
      "RecoveryIntervalSeconds": 30,
      "RecoveryBatchSize": 25
    }
  },
  "Logging": {
    "RequestTiming": {
      "Enabled": false
    },
    "Path": "logs/workers.log"
  }
}
