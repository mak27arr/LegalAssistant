{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Rag": {
    "DefaultTopK": 5,
    "MaxTopK": 20,
    "PromptTokenBudget": 6000,
    "ApproxCharsPerToken": 4
  },
  "Ollama": {
    "TimeoutSeconds": 300
  },
  "Authentication": {
    "PublicApiBaseUrl": "",
    "Google": {
      "ClientId": "",
      "ClientSecret": "",
      "CallbackPath": "/signin-google",
      "LoginPath": "/api/auth/google/login"
    },
    "Jwt": {
      "Issuer": "",
      "Audience": "",
      "SigningKey": "",
      "AccessTokenLifetimeMinutes": 15
    },
    "RefreshToken": {
      "LifetimeDays": 30,
      "CookieName": "legalassistant.refresh",
      "RotateOnUse": true
    },
    "Frontend": {
      "SuccessRedirectUrl": "",
      "FailureRedirectUrl": ""
    },
    "Bootstrap": {
      "AdminEmails": []
    }
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
