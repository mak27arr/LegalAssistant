{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Outbox": {
    "Processing": {
      "PollIntervalSeconds": 5,
      "LeaseDurationSeconds": 120,
      "BatchSize": 25,
      "MaxAttempts": 10
    }
  }
}
