{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RabbitMq": {
    "Processing": {
      "MaxAttempts": 5,
      "InitialDelaySeconds": 5,
      "MaxDelaySeconds": 300,
      "BackoffMultiplier": 2.0
    }
  }
  ,
  "Logging:RequestTiming": {
    "Enabled": false
  },
  "Logging:Path": "logs/embeddings.log"
}
