{
  "Rag": {
    "DefaultTopK": 5,
    "MaxTopK": 20,
    "PromptTokenBudget": 6000,
    "ApproxCharsPerToken": 4
  },
  "Ollama": {
    "TimeoutSeconds": 300
  },
  "Ask": {
    "Processing": {
      "PollIntervalSeconds": 2,
      "LeaseDurationSeconds": 120,
      "RecoveryIntervalSeconds": 30,
      "RecoveryBatchSize": 25
    }
  },
  "RabbitMq": {
    "Processing": {
      "MaxAttempts": 5,
      "InitialDelaySeconds": 5,
      "MaxDelaySeconds": 300,
      "BackoffMultiplier": 2.0
    }
  },
  "Outbox": {
    "Processing": {
      "PollIntervalSeconds": 5,
      "LeaseDurationSeconds": 120,
      "BatchSize": 25,
      "MaxAttempts": 10
    }
  },
  "Logging": {
    "Path": "logs/worker-ask.log"
  }
}
